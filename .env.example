# Copy to .env for local development, or set these in Project settings → Env.
# The platform injects DATABASE_URL and MYTHEX_WEB_ORIGIN automatically.

# Postgres connection string (required for accounts, history and usage limits).
DATABASE_URL=postgres://user:password@localhost:5432/toolnest

# Public origin of the site: canonical URLs, hreflang, sitemap.xml and robots.txt.
MYTHEX_WEB_ORIGIN=http://localhost:3000

# Optional ---------------------------------------------------------------

# Provider CA certificate, if TLS verification needs it (use \n for newlines).
# DATABASE_CA_CERT=

# Escape hatch: skip TLS verification (NOT recommended).
# DATABASE_SSL_NO_VERIFY=false

# Salt for hashing rate-limit keys (IPs). Keep it secret in production.
# RATE_LIMIT_SALT=change-me

# Frame policy for the X-Frame-Options header: SAMEORIGIN (default), DENY, or off.
# X_FRAME_OPTIONS=SAMEORIGIN
